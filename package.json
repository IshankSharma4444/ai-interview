{
  "name": "floating-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Windows floating AI assistant (Electron + React + Vite + Groq)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run build && cross-env RENDERER_MODE=file electron .",
    "focus-test": "npm run build && node scripts/focus-test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "koffi": "^3.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "3.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
